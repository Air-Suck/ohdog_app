<?xml version="1.0" encoding="utf-8"?>
<!-- 机器狗局域网控狗主界面（对应 phone/ip.ets 布局） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="机器狗 · 局域网控制"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="未连接"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnDiscover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="发现设备"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="断开"
                android:enabled="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/dogListTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="发现列表 (0)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/dogListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:minHeight="80dp"
            android:background="#F0F0F0"
            android:padding="4dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="运动（按住）"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnFwd"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="前进 W"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnLeft"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="左移 A"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="后退 S"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnRight"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="右移 D" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnYawL"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="左转 Q"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnYawR"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="右转 E"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="急停"
                android:backgroundTint="#C62828"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="模式"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button android:id="@+id/btnModeR" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="阻尼 R" android:layout_margin="2dp" />
            <Button android:id="@+id/btnModeX" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="空闲 X" android:layout_margin="2dp" />
            <Button android:id="@+id/btnModeZ" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="站立 Z" android:layout_margin="2dp" />
            <Button android:id="@+id/btnModeV" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="行走 V" android:layout_margin="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button android:id="@+id/btnModeB" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="后空翻 B" android:layout_margin="2dp" />
            <Button android:id="@+id/btnModeJ" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="跳跃 J" android:layout_margin="2dp" />
            <Button android:id="@+id/btnModeK" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="挥手 K" android:layout_margin="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#555555"
            android:maxLines="4" />
    </LinearLayout>
</ScrollView>
